{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["@playwright/test", "./helpers/assertions/assertError", "./helpers/assertions/assertUnauthorized", "node"],
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts", "helpers/**/*", "playwright.config.ts"]
}
